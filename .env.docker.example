# Copy to `.env.docker` and edit. Defaults target the bundled MySQL service
# (compose hostname "db"). Values here are read by the app container at runtime
# (docker-compose `env_file`). NEVER commit the real .env.docker.

# Provision the local MySQL with each Prisma schema on startup (local runs).
# Set to false in production where the databases already exist.
# ⚠️ MUST be false whenever DATABASE_URL* points at a real/remote database.
# `db push --accept-data-loss` drops any table not declared as a Prisma
# model on EVERY container start — e.g. the OMT module's raw-SQL tables
# (omt_tray_putaway, omt_activity_logs). This has already wiped OMT data
# in production once because this flag was left true after pointing the
# DATABASE_URL* vars at the real DB. entrypoint.sh now refuses to start in
# that combination, but don't rely on it — just set this to false.
RUN_DB_PUSH=true

# If you change this, also update the passwords in the connection strings below.
MYSQL_ROOT_PASSWORD=nexs_root_pw

# ── Prisma datasources ──────────────────────────────────────────────────────
# Pool limits are per datasource, per app process. Keep their combined total
# comfortably below MySQL's max_connections after multiplying by app replicas.
DATABASE_URL=mysql://root:nexs_root_pw@db:3306/nexs_mydb?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL_DISPATCH=mysql://root:nexs_root_pw@db:3306/nexs_dispatch?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL_LENS_LAB=mysql://root:nexs_root_pw@db:3306/nexs_lens_lab?connection_limit=5&connect_timeout=5&pool_timeout=10
DATABASE_URL_MF=mysql://root:nexs_root_pw@db:3306/nexs_metal_frame?connection_limit=5&connect_timeout=5&pool_timeout=10
# Retry only connection-establishment failures (P1001/P1002/P1017), using
# exponential delays. Attempts are capped at 5 in code.
DATABASE_RETRY_ATTEMPTS=3
DATABASE_RETRY_DELAY_MS=300
# Avoid re-checking OMT table definitions on every five-second UI refresh.
OMT_TABLE_CHECK_INTERVAL_MS=60000
# onSite datasource client is currently unused; set only if you enable it.
# ON_SITE_DB_URL=mysql://root:nexs_root_pw@db:3306/nexs_onsite

# ── Raw mysql2 pools (WAREHOUSE data — external in production) ───────────────
# Local dev: these point at the bundled docker MySQL (no external network
# needed). Leave as-is unless you're testing against real warehouse data.
NexS_DB=mysql://root:nexs_root_pw@db:3306/nexs_mydb
NexS_DB_PICKING=mysql://root:nexs_root_pw@db:3306/nexs_mydb
#
# Production: instead of pointing NexS_DB/NexS_DB_PICKING at a raw external
# IP with a static credential, set the matching *_ADAPTIVE_ENDPOINT var below.
# When set, it takes priority and the app reaches the warehouse DB through
# Lenskart's Adaptive PAM CLI (`adaptive exec <endpoint> -c "<sql>"`) instead -
# see src/utils/adaptiveExecPool.ts for how the pool/connection API is
# preserved so no call sites needed to change.
#
# Requirements this repo does NOT set up for you:
#   1. The `adaptive` CLI binary must be on PATH inside the running container.
#   2. Someone must run `adaptive login -u https://adaptive.lenskart.com` once,
#      interactively (browser auth), inside that container - login is one-time;
#      the resulting ~/.adaptive token is reused after that (see the
#      adaptive_token volume in docker-compose.yml, mounted at the app
#      container's $HOME/.adaptive so the token survives restarts).
#   3. If a query ever fails because the token expired, the app logs
#      "Ask ARYA to reauthenticate the Adaptive token" - rerun the login
#      command above in the running container when you see that.
# NEXS_DB_ADAPTIVE_ENDPOINT=mysql_ro_nexs-slave02.prod.internal
# NEXS_DB_PICKING_ADAPTIVE_ENDPOINT=mysql_ro_nexs-picking-mysql-slavedb

# ── bosch_cv_db (src/lib/db.ts) ─────────────────────────────────────────────
BOSCH_DB_HOST=db
BOSCH_DB_PORT=3306
BOSCH_DB_USER=root
BOSCH_DB_PASSWORD=nexs_root_pw
BOSCH_DB_NAME=bosch_cv_db

# ── App ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Keep true behind HTTPS. Set false only when browsers access an internal
# production container directly over plain HTTP.
AUTH_COOKIE_SECURE=true
BQ_PROJECT_ID=lenskart-datahub
# Data-bearing project used by native BigQuery reads, including Lens Lab FQC.
BQ_DATA_PROJECT_ID=lenskart-datahub
# For non-Compose deployments only; Compose mounts this default path.
# BQ_TOKEN_PATH=/app/src/utils/resources/bigquery/token.json

# MEI JobViewer / End Cut Grafana export. The endpoint is hard-limited to the
# rolling last 48 hours in Asia/Kolkata and runs one SQL query at a time.
ENDCUT_DB_HOST=
ENDCUT_DB_PORT=1433
ENDCUT_DB_NAME=JobViewer
ENDCUT_DB_USER=
ENDCUT_DB_PASSWORD=
ENDCUT_DB_ENCRYPT=true
ENDCUT_DB_TRUST_SERVER_CERTIFICATE=false
ENDCUT_DB_CONNECT_TIMEOUT_MS=15000
ENDCUT_QUERY_TIMEOUT_MS=600000
ENDCUT_QUERY_RETRIES=3

# Python interpreter used by the NDD-RCA route (venv baked into the image).
NDD_RCA_PYTHON=/opt/venv/bin/python
# Order Cancellation RCA uses NDD_RCA_PYTHON by default; override only if needed.
# ORDER_CANCELLATION_PYTHON=/opt/venv/bin/python
# ORDER_CANCELLATION_POWER_BI_DATASET_ID=6b5acf78-e529-4e2f-a946-2b9dae776371
# Lens Decanting uses the same server-only Power BI and Google token caches.
# LENS_DECANTING_PYTHON=/opt/venv/bin/python
# LENS_DECANTING_POWER_BI_DATASET_ID=d87d7c18-ccb0-4dc6-b638-57283c146d4b
LENS_DECANTING_GRN_SHEET_ID=1rzdAumq4FihV9DHDUkqBRiceicsJZ4WCHdWKHhLEYFk
LENS_DECANTING_GRN_RANGE=EyeFrame!R:U
# LENS_DECANTING_SKIP_GOOGLE=1
# Frame Decanting uses a distinct three-calendar-month Power BI model and
# inherits the Lens GRN sheet/range unless these are set separately.
# FRAME_DECANTING_PYTHON=/opt/venv/bin/python
# PBI_FRAME_ROS_DATASET_ID=e30504e3-a2a6-4cd2-9ba6-b2b2a6456d15
# PBI_FRAME_ROS_TABLE=fulfilment_data
# PBI_FRAME_ROS_PID_COL=product_id
# PBI_FRAME_ROS_ORDER_COL=increment_id
# PBI_FRAME_ROS_STATUS_COL=Overall Status
# PBI_FRAME_ROS_DATE_TABLE=Dim_Date_TimeLine
# PBI_FRAME_ROS_DATE_COL=Date
# FRAME_DECANTING_GRN_SHEET_ID=1rzdAumq4FihV9DHDUkqBRiceicsJZ4WCHdWKHhLEYFk
# FRAME_DECANTING_GRN_RANGE=EyeFrame!R:U
# FRAME_DECANTING_SKIP_GOOGLE=1
# Versioned PLC/exclusion snapshots are bundled at the paths below. Set these
# only to override them with authoritative read-only files mounted elsewhere.
# FRAME_DECANTING_PLC_FILE="/app/src/lib/plc flag.csv"
# FRAME_DECANTING_PID_EXCLUSION_FILE="/app/src/lib/pid excusion.csv"
# Reserve Inventory persists its exact 62-day snapshot in the app_data volume.
# RESERVE_INVENTORY_CACHE_PATH=/app/data/cache/reserve-inventory.json
# Secondary Power BI models; defaults match the supplied pipeline.
# FRAME_DECANTING_INCREFF_DATASET_ID=0ceb1d75-315f-448e-8e92-2c2ed9683d21
# FRAME_DECANTING_TRANSFER_DATASET_ID=df27c97c-adca-4e29-b965-85e51294dff2
# Override these only if the transfer semantic model uses different names.
# FRAME_DECANTING_TRANSFER_STATUS_COL=status
# FRAME_DECANTING_TRANSFER_STATUS_VALUE=READY_TO_RECEIVE
# FRAME_DECANTING_TRANSFER_SOURCE_COL=source_facility
# FRAME_DECANTING_TRANSFER_DESTINATION_COL=destination_facility
# Delegated auth silently renews this mounted cache. Override only when the
# deployment mounts it elsewhere.
# POWER_BI_TOKEN_CACHE_PATH=/app/src/utils/resources/power-bi/pbi_token_cache.json
# For unattended app-only auth, provide an Entra app registration instead:
# POWER_BI_TENANT_ID=8824ff7a-5893-46d2-931e-5bf425c1c3c5
# POWER_BI_CLIENT_ID=
# POWER_BI_CLIENT_SECRET=
# Diagnostic fallback: disables Sheet lookups and marks dependent cases for review.
# ORDER_CANCELLATION_SKIP_GOOGLE=1

# ConsolidAte Order QC dump auth (primary — server logs in to NexS and auto-refreshes
# the jwt-token; no cookie paste, no extension, works on any origin).
# CONFIRMED working shape (login returns the JWT in the response `content` field):
#   - body is exactly {"userName","password"}  (strict schema)
#   - x-lenskart-app-id header identifies the app;  nexs-analytics works for login
#   - NEXS_USERNAME is the emp-code (e.g. 197531), NOT the email
# NEXS_AUTH_URL=https://app.nexs.lenskart.com/v1/user/login
# NEXS_USERNAME=197531
# NEXS_PASSWORD=...
# NEXS_APP_ID=nexs-analytics
# NEXS_FACILITY=NXS1
# NEXS_WORKSTATION=QC01
# NEXS_AUTH_BODY={"userName":"{USERNAME}","password":"{PASSWORD}"}   # optional; this is the default

# CL/CLS QC runner (user credentials are entered in the panel and never stored)
# CL_CLS_QC_URL=https://app.nexs.lenskart.com/qc
# CL_CLS_LOGIN_URL=https://app.nexs.lenskart.com/login
# CL_CLS_QC_PROFILE_DIR=./data/cl-cls-qc-profile
# Docker already installs /usr/bin/chromium; operator PCs need no browser setup.
# CL_CLS_QC_EXECUTABLE_PATH=/usr/bin/chromium
# CL_CLS_QC_BROWSER_CHANNEL=chrome  # local only, omit in Docker
# CL_CLS_QC_HEADLESS=true

# ── Build-time only (set via compose build args, shown here for reference) ────
# NEXT_PUBLIC_AGENT_URL is inlined at build time; set it in the shell before
# `docker compose build`, e.g.  NEXT_PUBLIC_AGENT_URL=https://agent.example.com
